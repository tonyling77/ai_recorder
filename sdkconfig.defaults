CONFIG_IDF_TARGET="esp32s31"

# Public CA bundle for the injected UPLOAD_ORIGIN HTTPS inbox. Do not skip verification.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# Cloudflare sends GTS Root R4 cross-signed by GlobalSign Root CA. That root
# is absent from the default bundle, so keep verification and add this one CA.
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="certs/globalsign-root-ca.pem"
# CONFIG_ESP_TLS_INSECURE is not set
# CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY is not set
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Persist ESP-IDF Core Dumps and the bounded ESP-Iris pre-crash log ring in
# the retained coredump partition after a panic.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=64
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_FACTORY_RECOVERY_BOOT_GPIO=7
CONFIG_FACTORY_RECOVERY_BOOT_DEBOUNCE_MS=50

# USB High-Speed is owned by ESP-Iris. Device installation and logs go through
# the repository's mosaico.py commands. Keep the console on UART and avoid the
# built-in USB Serial/JTAG controller.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_IRIS_TRANSPORT_USB=y
CONFIG_ESP_IRIS_TRANSPORT_TCP=y
CONFIG_ESP_IRIS_NVS_PARTITION_NAME="sysmeta"
CONFIG_ESP_IRIS_TRANSPORT_CLAIM_TIMEOUT_MS=2000
CONFIG_ESP_IRIS_TCP_PORT=19772
CONFIG_ESP_IRIS_TCP_PAIRING=y
CONFIG_ESP_IRIS_TCP_DEFER_UNTIL_NETIF=y
CONFIG_ESP_IRIS_TASK_STACK_SIZE=3328
CONFIG_ESP_IRIS_USB_TASK_STACK_SIZE=2048
CONFIG_ESP_IRIS_SERVICE_STACK_SIZE=4096
CONFIG_ESP_IRIS_SERVICE_PERSISTENT=y
CONFIG_ESP_IRIS_SERVICE_CONTEXT_PSRAM=y
CONFIG_ESP_IRIS_SERVICE_STATE_PSRAM=y
CONFIG_ESP_IRIS_RPC_RESPONSE_PSRAM=y
CONFIG_ESP_IRIS_WIRE_BUFFERS_PSRAM=y
CONFIG_ESP_IRIS_LOG_RING_BYTES=4096
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP_IRIS_LOG_RING_STORAGE_PSRAM=y
# Mirror chunks are copied into ESP-Iris's wire frame before USB DMA.
CONFIG_ESP_IRIS_MEDIA_BUFFER_PSRAM=y
# ESP-Iris assembles a wire frame in its own 4096-byte buffer. CDC can feed
# and drain it in chunks; keep RX >= endpoint capacity.
CONFIG_TINYUSB_CDC_RX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_TX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_EP_BUFSIZE=512

# ESP-Mosaico 480x480 CO5300 QSPI display. GSP presents through
# esp_display_present; the BSP still pulls LVGL as a dependency.
CONFIG_BSP_CO5300_ENABLE_TE=y
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y

# FreeType smooth rasterizer for CJK glyphs needs more render-task stack than
# the 24 KB default; entering the notes scene crashed in gray_convert_glyph.
CONFIG_ESP_GSP_RENDER_TASK_STACK_SIZE_FREETYPE=40960

# mbedtls TLS buffers (16 KB in + 4 KB out per connection) in internal RAM
# starve the heap — min_free_internal dropped to ~2 KB and mbedtls_ssl_setup
# failed with MBEDTLS_ERR_SSL_ALLOC_FAILED. Move TLS allocations to PSRAM.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Records in PSRAM make hardware AES allocate a DMA bounce buffer. That
# allocation fails here, so the Xiaozhi response never reaches the screen.
# CONFIG_MBEDTLS_HARDWARE_AES is not set
# Hardware SHA keeps its context in internal DMA memory. That pool is too
# small once Wi-Fi and RainMaker are up, so the check-in handshake returns
# PSA_ERROR_INSUFFICIENT_MEMORY and the screen never receives a code.
# CONFIG_MBEDTLS_HARDWARE_SHA is not set
# One RainMaker TLS session already holds a 16 KB input buffer. A second
# session for the Xiaozhi check-in then fails setup. The activation JSON fits
# in 8 KB.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192

CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n
# Prefer PSRAM for Wi-Fi / lwIP so the larger TCP send window below does not
# starve internal heap. Default SND_BUF 5760 caps upload near 56 KB/s at ~100 ms RTT.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_ESP_WIFI_TX_BA_WIN=16

CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480
CONFIG_ESP_TASK_WDT_INIT=n

CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="1.0.0"

CONFIG_TINYUSB_CDC_COUNT=2

# RainMaker Neo claim. fctry holds PoP; app nvs holds Wi-Fi. No Neo OTA.
CONFIG_ESP_RMAKER_FACTORY_PARTITION_NAME="fctry"
CONFIG_APP_NETWORK_FACTORY_NVS_PARTITION_NAME="fctry"
# The registry takes the name of the Kconfig symbol as the namespace, and
# RainMaker Neo renamed that symbol, so the default became the name
# "ESP_RMAKER_FACTORY_NAMESPACE" instead of the value. That name is longer
# than NVS allows, so the PoP random could not be stored at all:
# "open PoP namespace fctry/ESP_RMAKER_FACTORY_NAMESPACE:
# ESP_ERR_NVS_KEY_TOO_LONG". The name of the Neo light example is used here.
CONFIG_APP_NETWORK_PROV_DATA_NAMESPACE="rmaker_creds"
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=3072
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_APP_NETWORK_PROV_TRANSPORT_BLE=y
CONFIG_APP_NETWORK_PROV_COMPACT_QR=y

# Wi-Fi takes about 55 KB of internal memory that DMA can use, and the
# display needs some of the same pool at the same time. The margin was a few
# hundred bytes, so the board aborted in esp_wifi_init() depending on how
# the allocations fell. An allocation smaller than this threshold stays in
# internal memory; lowering the threshold leaves that memory to Wi-Fi.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# Mount the existing Vibe LittleFS through the block-device layer.
# Iris NAND system update stays off; a failed mount must not format the volume.
# The NAND page is 2048 bytes, so the LittleFS cache must be that page.
CONFIG_NAND_FLASH_ENABLE_BDL=y
CONFIG_LITTLEFS_CACHE_SIZE=2048


